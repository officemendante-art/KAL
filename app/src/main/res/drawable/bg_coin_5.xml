<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer mint-wash body -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#CFF6E3"
                android:centerColor="#BFF0D8"
                android:endColor="#A6ECCB"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#400A3622" />
        </shape>
    </item>
    <!-- Inner coin rim ring -->
    <item
        android:bottom="3.5dp"
        android:left="3.5dp"
        android:right="3.5dp"
        android:top="3.5dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#330A3622" />
        </shape>
    </item>
</layer-list>
